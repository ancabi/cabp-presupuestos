# ---- Desarrollo local (npm run dev) ----
# Conexión a MariaDB
DATABASE_URL=mysql://cabp:cabp@localhost:3306/cabp
# Secreto largo y aleatorio: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Carpeta de imágenes y PDFs de los clientes (relativa a la raíz del proyecto o absoluta)
UPLOADS_DIR=./uploads
PORT=3000
NODE_ENV=development

